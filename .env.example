# ============================================================================
# Aegis v2 — environment variables (copy to .env, fill in, never commit).
# NEVER commit .env — only the publishable (anon) Supabase key goes in client
# code. The SERVICE_ROLE key must never appear in code or a public repo.
# ============================================================================

# ---- Supabase (health history, auth, ML) — REQUIRED ----
SUPABASE_URL=https://kagjbxxmdyaypfcqemem.supabase.co
SUPABASE_KEY=sb_publishable_XXXX                   # publishable/anon key only

# ---- Which clouds to monitor (JSON; omit to use defaults in packages/common/config.js) ----
# TARGETS=[{"name":"render","url":"https://YOUR_APP.onrender.com/health","region":"oregon","enabled":true}]

# ---- Monitor behaviour ----
MONITOR_REGION=oracle-vm                          # vantage point label
SELF_HEAL_AFTER=3                                 # consecutive failures → redeploy
LATENCY_SLOW_MS=800                               # above this = "degraded"
CHECK_CONCURRENCY=4
MONITOR_INTERVAL_S=300                            # seconds between cycles (docker)

# ---- Self-healing (GitHub Actions deploy dispatch) ----
GITHUB_REPO=Manav32478/aegis-platform-
GITHUB_TOKEN=ghp_XXXX                             # PAT with "workflow" scope (secret)

# ---- Alerting (optional, all free) ----
SLACK_WEBHOOK_URL=                                # Slack incoming webhook (free)
ALERT_WEBHOOK_URL=                                # any webhook (e.g. ntfy.sh)
REPORT_WEBHOOK_URL=
RESEND_API_KEY=                                   # free tier → email reports
REPORT_TO_EMAIL=

# ---- Web portal ----
PORT=3100
ADMIN_TOKEN=change-me                             # protects /api/admin/*

# ---- API service ----
ALLOWED_KEYS=                                     # comma-separated demo keys (dev only)
RATE_MAX=60                                       # requests/min per key

# ---- Carbon (optional live data) ----
ELECTRICITYMAP_KEY=                               # free tier at api.electricitymap.org
